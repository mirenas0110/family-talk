<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FAMILY APP</title>
  
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif;
      border-radius: 0 !important;
    }

    body {
      background-color: #121212;
      color: #e0e0e0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hidden {
      display: none !important;
    }

    .login-box {
      background: #1e1e1e;
      width: 90%;
      max-width: 340px;
      padding: 30px 20px;
      border: 1px solid #333;
    }

    .login-box h2 {
      font-size: 14px;
      letter-spacing: 2px;
      margin-bottom: 20px;
      color: #fff;
      text-align: center;
    }

    input {
      width: 100%;
      padding: 12px;
      margin-bottom: 12px;
      border: 1px solid #333;
      background: #121212;
      color: #fff;
      font-size: 13px;
      outline: none;
    }

    button {
      width: 100%;
      padding: 12px;
      border: 1px solid #fff;
      font-size: 12px;
      cursor: pointer;
      background: #fff;
      color: #121212;
      font-weight: bold;
    }

    button.sec {
      background: transparent;
      color: #fff;
      border: 1px solid #333;
      margin-top: 8px;
    }

    .app-container {
      background: #121212;
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .tab-content {
      display: none;
      flex: 1;
      padding: 20px;
      overflow-y: auto;
    }

    .tab-content.active {
      display: block;
    }

    .title {
      font-size: 12px;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 16px;
    }

    .bottom-nav {
      height: 50px;
      background: #1e1e1e;
      border-top: 1px solid #222;
      display: flex;
    }

    .nav-btn {
      flex: 1;
      background: none;
      border: none;
      color: #666;
      font-size: 10px;
      cursor: pointer;
    }

    .nav-btn.active {
      color: #fff;
      background: #222;
    }

    .chat-box {
      border: 1px solid #222;
      padding: 10px;
      height: 250px;
      overflow-y: auto;
      margin-bottom: 10px;
      background: #181818;
    }

    .msg {
      margin-bottom: 8px;
      font-size: 12px;
    }
  </style>
</head>
<body>

  <!-- ログイン画面 -->
  <div id="loginArea" class="login-box">
    <h2>AUTHENTICATION</h2>
    <input type="text" id="myId" placeholder="USER ID">
    <input type="password" id="myPass" placeholder="PASSWORD">
    <button onclick="login()">LOG IN</button>
    <button onclick="login()" class="sec">GUEST ENTER</button>
  </div>

  <!-- メイン画面 -->
  <div id="mainArea" class="app-container hidden">

    <div id="tab1" class="tab-content active">
      <div class="title">CALENDAR</div>
      <p style="font-size:12px; color:#666;">No events scheduled.</p>
    </div>

    <div id="tab2" class="tab-content">
      <div class="title">TALK</div>
      <div id="chatLog" class="chat-box"></div>
      <div style="display:flex; gap:6px;">
        <input type="text" id="chatInput" placeholder="Message..." style="margin:0;">
        <button onclick="sendMsg()" style="width:70px;">SEND</button>
      </div>
    </div>

    <div id="tab3" class="tab-content">
      <div class="title">SETTING</div>
      <button onclick="location.reload()" class="sec">LOG OUT</button>
    </div>

    <div id="tab4" class="tab-content">
      <div class="title">BOARD</div>
      <p style="font-size:12px; color:#666;">No board posts.</p>
    </div>

    <div id="tab5" class="tab-content">
      <div class="title">EXTRA</div>
      <p style="font-size:12px; color:#666;">No extra items.</p>
    </div>

    <!-- 下部ナビゲーション -->
    <nav class="bottom-nav">
      <button class="nav-btn active" onclick="setTab(1)">CALENDAR</button>
      <button class="nav-btn" onclick="setTab(2)">TALK</button>
      <button class="nav-btn" onclick="setTab(3)">SETTING</button>
      <button class="nav-btn" onclick="setTab(4)">BOARD</button>
      <button class="nav-btn" onclick="setTab(5)">EXTRA</button>
    </nav>
  </div>

  <script>
    function login() {
      document.getElementById("loginArea").classList.add("hidden");
      document.getElementById("mainArea").classList.remove("hidden");
    }

    function setTab(num) {
      const tabs = document.querySelectorAll(".tab-content");
      const btns = document.querySelectorAll(".nav-btn");
      
      tabs.forEach((t, i) => {
        if (i === num - 1) {
          t.classList.add("active");
        } else {
          t.classList.remove("active");
        }
      });

      btns.forEach((b, i) => {
        if (i === num - 1) {
          b.classList.add("active");
        } else {
          b.classList.remove("active");
        }
      });
    }

    function sendMsg() {
      const input = document.getElementById("chatInput");
      const log = document.getElementById("chatLog");
      if (!input.value.trim()) return;
      
      const item = document.createElement("div");
      item.className = "msg";
      item.innerText = input.value;
      log.appendChild(item);
      
      input.value = "";
      log.scrollTop = log.scrollHeight;
    }
  </script>
</body>
</html>
